languagesystem DFLT dflt;
languagesystem latn dflt;

@CombiningTop = [acutecomb gravecomb tildecomb uni0302 uni0304 uni0306 uni0307 uni0308 uni030A uni030B uni030C];
@CombiningBottom = [uni0326 uni0327 uni0328];

feature ccmp {
    lookup soft_dotted {
        sub i' @CombiningTop by dotlessi;
        sub i' @CombiningBottom @CombiningTop by dotlessi;
        sub i' @CombiningBottom @CombiningBottom @CombiningTop by dotlessi;
        sub j' @CombiningTop by dotlessj;
        sub j' @CombiningBottom @CombiningTop by dotlessj;
        sub iogonek' @CombiningTop by iogonek.dotless;
        sub iogonek' @CombiningBottom @CombiningTop by iogonek.dotless;
    } soft_dotted;
} ccmp;

feature ss01 {
    featureNames { name "Descending f"; };
    sub f by f.ss01;
} ss01;

feature salt {
    sub f by f.ss01;
} salt;

feature case {
    sub hyphen by hyphen.case;
    sub endash by endash.case;
    sub emdash by emdash.case;
    sub guillemotleft by guillemotleft.case;
    sub guillemotright by guillemotright.case;
    sub guilsinglleft by guilsinglleft.case;
    sub guilsinglright by guilsinglright.case;
    sub periodcentered by periodcentered.case;
    sub bullet by bullet.case;
} case;
